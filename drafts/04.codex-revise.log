html=Path('chapters/04-spray-crew-file.html').read_text()
class Audit(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.paras=[]; self.lede=[]
 def handle_starttag(self,tag,attrs):
  if tag=='p':
   cls=dict(attrs).get('class','')
   self.stack.append((cls,[]))
 def handle_data(self,data):
  if self.stack: self.stack[-1][1].append(data)
 def handle_endtag(self,tag):
  if tag=='p' and self.stack:
   cls,parts=self.stack.pop(); txt=' '.join(''.join(parts).split()); self.paras.append(txt)
   if 'lede' in cls.split(): self.lede.append(txt)
a=Audit(); a.feed(html)
wc=lambda s: len(re.findall(r\"\\b[\\w'’-]+\\b\",s))
print('lede words:', wc(a.lede[0]))
print('max paragraph words:', max(map(wc,a.paras)))
text=' '.join(a.paras)
sents=re.split(r'(?<=[."'!?])'"\\s+(?=[A-Z“€])',text)
print('max sentence words:', max(map(wc,sents)))
rows=Path('checks/claims/04.tsv').read_text().splitlines()[1:]
checked=sum(line.endswith('checked-by:codex:2026-09-05') for line in rows)
inference=sum(line.endswith('\\tinference') for line in rows)
excerpts=len(list(Path('resources/sources/04/excerpts').glob('*.txt')))
print(f'ledger audit: {checked} checked, {inference} inference, {excerpts} excerpts')
