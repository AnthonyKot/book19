from html.parser import HTMLParser
from pathlib import Path
import re
class Audit(HTMLParser):
    def __init__(self):
        super().__init__(); self.active=[]; self.blocks=[]; self.lede=[]; self.in_lede=False
    def handle_starttag(self,tag,attrs):
        cls=(dict(attrs).get('class') or '').split()
        if tag in {'p','li'}: self.active.append([tag,[]])
        if tag=='p' and 'lede' in cls: self.in_lede=True
    def handle_data(self,data):
        for b in self.active:b[1].append(data)
        if self.in_lede:self.lede.append(data)
    def handle_endtag(self,tag):
        if tag=='p' and self.in_lede:self.in_lede=False
        for i in range(len(self.active)-1,-1,-1):
            if self.active[i][0]==tag:
                self.blocks.append(self.active.pop(i)); break
word=lambda s:len(re.findall(r\"\\b[\\w'’-]+\\b\",re.sub(r'\\s+',' ',s)))
a=Audit();a.feed(Path('chapters/01-cell-file.html').read_text())
lede=word(' '.join(a.lede))
paras=[(word(' '.join(t)),tag,' '.join(t)) for tag,t in a.blocks]
long_s=[]
for _,tag,t in paras:
    for s in re.split(r'(?<=[."'!?])(?:[”’'"\\\"])?\\s+',re.sub(r'\\s+',' ',t.strip())):
        n=word(s)
        if n>=40:long_s.append((n,s))
print(f'lede={lede}; longest paragraph/list-item={max(n for n,_,_ in paras)}; sentences >=40={len(long_s)}')
if long_s:
    print(*long_s,sep='\\n')
assert lede <= 130
assert max(n for n,_,_ in paras) < 150
assert not long_s
PY
