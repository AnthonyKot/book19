from html.parser import HTMLParser
from pathlib import Path
import csv,re
class Blocks(HTMLParser):
    TAGS={'p','li','td','th'}
    def __init__(self): super().__init__(); self.stack=[]; self.blocks=[]; self.lede=[]
    def handle_starttag(self,tag,attrs):
        if tag in self.TAGS:
            self.stack.append([tag,dict(attrs),[]])
    def handle_data(self,data):
        for block in self.stack: block[2].append(data)
    def handle_endtag(self,tag):
        if self.stack and self.stack[-1][0]==tag:
            _,attrs,parts=self.stack.pop(); text=re.sub(r'\\s+',' ',' '.join(parts)).strip(); self.blocks.append((tag,attrs,text))
            if tag=='p' and 'lede' in (attrs.get('class') or '').split(): self.lede.append(text)
p=Blocks(); p.feed(Path('chapters/02-border-files.html').read_text())
word=lambda s: re.findall(r\"\\b[\\w'’–-]+\\b\",s)
