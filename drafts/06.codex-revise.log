diff --git a/chapters/06-certified-inspection-microfirm.html b/chapters/06-certified-inspection-microfirm.html
index 40a82133e9c7c4e06b24daa15e5312c4f34a66fe..64d0686caa91a39ae83135feec24de7aca1a097d
--- a/chapters/06-certified-inspection-microfirm.html
