from html.parser import HTMLParser
import re, pathlib
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.out=[]; self.buf=[]
 def handle_starttag(self,tag,attrs):
  self.stack.append(tag)
  if tag in ('p','li','h1','h2'): self.buf=[]
 def handle_data(self,d):
  if self.stack and self.stack[-1] in ('p','li','strong','em','a'): self.buf.append(d)
 def handle_endtag(self,tag):
  if tag in ('p','li'):
   t=' '.join(' '.join(self.buf).split())
   self.out.append((tag,t)); self.buf=[]
  if tag in self.stack:
   for i in range(len(self.stack)-1,-1,-1):
